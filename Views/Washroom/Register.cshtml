@{
    ViewBag.Title = "Register Washroom - SE1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="register-section">
    <div class="container">
        <div class="register-card">

            <div class="back-to-home">
                <a href="/" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </a>
                <a href="/Washroom/MyWashrooms" class="btn-view-my">
                    <i class="fas fa-list"></i> My Washrooms
                </a>
            </div>

            <div class="register-header">
                <i class="fas fa-building register-icon"></i>
                <h2>Register Your Washroom</h2>
                <p>Fill in the details to list your washroom on SE1</p>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            <form method="post" action="/Washroom/Register" class="register-form" enctype="multipart/form-data" id="registerForm">

                
                <div class="form-section">
                    <h3><i class="fas fa-info-circle"></i> Basic Information</h3>

                    <div class="form-group">
                        <label><i class="fas fa-toilet"></i> Washroom Name <span class="required">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. City Center Washroom" required>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-map-marker-alt"></i> Address <span class="required">*</span></label>
                        <input type="text" name="address" class="form-control" placeholder="Full address with area/city" required>
                    </div>

                    
                    <div class="form-group">
                        <label><i class="fas fa-map-pin"></i> Location on Map <span class="required">*</span></label>
                        <div class="location-picker">
                            <div class="location-input-group">
                                <input type="text" id="locationSearch" class="form-control" placeholder="Search for location..." value="Chittagong, Bangladesh">
                                <button type="button" class="btn-search-location" onclick="searchLocation()">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                            <button type="button" class="btn-get-location" onclick="getCurrentLocationForMap()">
                                <i class="fas fa-crosshairs"></i> Use My Location
                            </button>
                        </div>

                        
                        <div id="mapContainer" style="height: 250px; margin-top: 10px; border-radius: 12px; border: 1px solid #e2e8f0; width: 100%;"></div>

                       
                        <div class="coord-info">
                            <span id="coordDisplay">📍 Location: <strong>22.3384, 91.8321</strong> (Chittagong)</span>
                            <input type="hidden" name="latitude" id="latitude" value="22.3384">
                            <input type="hidden" name="longitude" id="longitude" value="91.8321">
                            <input type="hidden" name="city" id="cityName" value="Chittagong">
                        </div>
                        <small class="form-text">Click on the map to select location, or search for a place</small>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-clock"></i> Opening Hours <span class="required">*</span></label>
                        <input type="text" name="openingHours" class="form-control" placeholder="e.g. 8:00 AM - 10:00 PM or 24/7" required>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-money-bill"></i> Usage Cost (BDT)</label>
                        <input type="number" name="usageCost" class="form-control" placeholder="0 for free" step="0.01" value="0">
                    </div>
                </div>

                
                <div class="form-section">
                    <h3><i class="fas fa-shield-alt"></i> Hygiene & Security</h3>

                    <div class="form-group">
                        <label><i class="fas fa-shield-alt"></i> Security Status <span class="required">*</span></label>
                        <select name="securityStatus" class="form-control" required>
                            <option value="">Select Security Status</option>
                            <option value="Very Safe">Very Safe</option>
                            <option value="Safe">Safe</option>
                            <option value="Needs Attention">Needs Attention</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-users"></i> Crowd Level <span class="required">*</span></label>
                        <select name="crowdLevel" class="form-control" required>
                            <option value="">Select Crowd Level</option>
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                </div>

               
                <div class="form-section">
                    <h3><i class="fas fa-concierge-bell"></i> Facilities & Amenities</h3>

                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="bathAvailability" value="true">
                            <span><i class="fas fa-shower"></i> Bath / Shower Available</span>
                        </label>
                    </div>

                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="babyFacility" value="true">
                            <span><i class="fas fa-baby"></i> Baby Changing Station / Baby Facilities</span>
                        </label>
                    </div>

                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="wheelchairAccess" value="true">
                            <span><i class="fas fa-wheelchair"></i> Wheelchair Accessible</span>
                        </label>
                    </div>

                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="handwash" value="true">
                            <span><i class="fas fa-hand-wash"></i> Handwashing Facilities</span>
                        </label>
                    </div>

                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="handDryer" value="true">
                            <span><i class="fas fa-wind"></i> Hand Dryer Available</span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-align-left"></i> Description</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Additional information about your washroom..."></textarea>
                    </div>
                </div>

                
                <div class="form-section image-upload-section">
                    <h3><i class="fas fa-image"></i> Washroom Image <span class="required">*</span></h3>
                    <p class="image-upload-hint">Upload one image of your washroom (JPG, PNG, JPEG) - Max 5MB</p>

                    <div class="image-upload-area" id="dropArea">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <h4>Drag & Drop Image Here</h4>
                        <p>or click to browse</p>
                        <input type="file" name="washroomImage" id="fileInput" class="file-input" accept=".jpg,.jpeg,.png" onchange="handleFileSelect(event)">
                        <button type="button" class="btn-browse" onclick="document.getElementById('fileInput').click()">
                            <i class="fas fa-folder-open"></i> Browse File
                        </button>
                    </div>

                    <div class="image-preview-container" id="imagePreviewContainer">
                        <p style="color:#94a3b8; padding:20px;">No image selected</p>
                    </div>

                    <div class="upload-info">
                        <span id="imageStatus">❌ No image selected</span>
                    </div>
                </div>

                <button type="submit" class="btn-register" id="submitBtn">
                    <i class="fas fa-plus-circle"></i> Register Washroom
                </button>
            </form>

            <div class="register-footer">
                <p><i class="fas fa-info-circle"></i> Your washroom will be reviewed by admin before going live.</p>
            </div>
        </div>
    </div>
</section>


