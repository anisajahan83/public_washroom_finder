<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
   

    var map;
    var marker;
    var currentLat = 22.3384;
    var currentLng = 91.8321;
    var currentCity = "Chittagong";

    
    document.addEventListener('DOMContentLoaded', function() {
        initMap(currentLat, currentLng);
    });

    function initMap(lat, lng) {
       
        if (map) {
            map.remove();
        }

        map = L.map('mapContainer').setView([lat, lng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        
        var icon = L.divIcon({
            html: '<i class="fas fa-map-marker-alt" style="color:#e76f51; font-size:2rem; text-shadow:0 2px 4px rgba(0,0,0,0.3);"></i>',
            className: '',
            iconSize: [30, 42],
            iconAnchor: [15, 42]
        });

        marker = L.marker([lat, lng], { draggable: true, icon: icon }).addTo(map);

       
        marker.on('dragend', function(e) {
            var pos = marker.getLatLng();
            updateCoordinates(pos.lat, pos.lng);
            reverseGeocode(pos.lat, pos.lng);
        });

        map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            updateCoordinates(e.latlng.lat, e.latlng.lng);
            reverseGeocode(e.latlng.lat, e.latlng.lng);
        });

        
        document.getElementById('mapContainer').style.display = 'block';
    }

    function updateCoordinates(lat, lng) {
        currentLat = lat;
        currentLng = lng;
        document.getElementById('latitude').value = lat.toFixed(6);
        document.getElementById('longitude').value = lng.toFixed(6);
        document.getElementById('coordDisplay').innerHTML = '📍 Location: <strong>' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '</strong> (' + currentCity + ')';
    }

    function reverseGeocode(lat, lng) {
        var url = 'https://nominatim.openstreetmap.org/reverse?lat=' + lat + '&lon=' + lng + '&format=json&zoom=10';

        fetch(url)
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data && data.address) {
                    var city = '';
                    if (data.address.city) city = data.address.city;
                    else if (data.address.town) city = data.address.town;
                    else if (data.address.village) city = data.address.village;
                    else if (data.address.county) city = data.address.county;
                    else if (data.address.state) city = data.address.state;

                    if (city) {
                        currentCity = city;
                        document.getElementById('cityName').value = city;
                        document.getElementById('coordDisplay').innerHTML = '📍 Location: <strong>' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '</strong> (' + city + ')';
                    }
                }
            })
            .catch(function() {
                
            });
    }

    function searchLocation() {
        var query = document.getElementById('locationSearch').value.trim();
        if (!query) return;

        var url = 'https://nominatim.openstreetmap.org/search?q=' + encodeURIComponent(query) + '&format=json&limit=1';

        fetch(url)
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data && data.length > 0) {
                    var lat = parseFloat(data[0].lat);
                    var lng = parseFloat(data[0].lon);
                    var displayName = data[0].display_name || query;

                   
                    var parts = displayName.split(',');
                    var city = parts[parts.length - 2] || parts[0] || query;
                    city = city.trim();

                    currentCity = city;
                    document.getElementById('cityName').value = city;
                    document.getElementById('locationSearch').value = city;

                   
                    map.setView([lat, lng], 13);
                    marker.setLatLng([lat, lng]);
                    updateCoordinates(lat, lng);
                    document.getElementById('coordDisplay').innerHTML = '📍 Location: <strong>' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '</strong> (' + city + ')';
                } else {
                    showToast('⚠️ Location not found. Please try again.');
                }
            })
            .catch(function() {
                showToast('⚠️ Error searching location. Please try again.');
            });
    }

    function getCurrentLocationForMap() {
        if (!navigator.geolocation) {
            showToast('⚠️ Geolocation is not supported by your browser');
            return;
        }

        navigator.geolocation.getCurrentPosition(
            function(position) {
                var lat = position.coords.latitude;
                var lng = position.coords.longitude;

                map.setView([lat, lng], 15);
                marker.setLatLng([lat, lng]);
                updateCoordinates(lat, lng);
                reverseGeocode(lat, lng);
                showToast('📍 Location detected!');
            },
            function(error) {
                var msg = 'Unable to detect location. ';
                switch (error.code) {
                    case error.PERMISSION_DENIED:
                        msg += 'Please allow location access.';
                        break;
                    case error.POSITION_UNAVAILABLE:
                        msg += 'Location information unavailable.';
                        break;
                    case error.TIMEOUT:
                        msg += 'Location request timed out.';
                        break;
                    default:
                        msg += 'Please search manually.';
                }
                showToast('⚠️ ' + msg);
            },
            {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 0
            }
        );
    }

    
    document.getElementById('locationSearch').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            searchLocation();
        }
    });

    

    var selectedFile = null;

    function handleFileSelect(event) {
        var file = event.target.files[0];
        if (file) {
            addFile(file);
        }
        event.target.value = '';
    }

    function addFile(file) {
        if (!file.type.startsWith('image/')) {
            showToast('⚠️ Please select an image file (JPG, PNG)');
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            showToast('⚠️ File size should be less than 5MB');
            return;
        }

        selectedFile = file;
        updatePreview();
        updateStatus();
        document.querySelector('.image-upload-area').classList.add('has-image');
        document.getElementById('imageError').textContent = '';
    }

    function removeFile() {
        selectedFile = null;
        updatePreview();
        updateStatus();
        document.querySelector('.image-upload-area').classList.remove('has-image');
        document.getElementById('fileInput').value = '';
    }

    function updatePreview() {
        var container = document.getElementById('imagePreviewContainer');

        if (!selectedFile) {
            container.innerHTML = '<p style="color:#94a3b8; padding:20px;">No image selected</p>';
            return;
        }

        var reader = new FileReader();
        reader.onload = function(e) {
            container.innerHTML = `
                    <div class="image-preview-item">
                        <img src="${e.target.result}" alt="${selectedFile.name}">
                        <button type="button" class="remove-btn" onclick="removeFile()">
                            <i class="fas fa-times"></i>
                        </button>
                        <div class="file-name">${selectedFile.name}</div>
                    </div>
                `;
        };
        reader.readAsDataURL(selectedFile);
    }

    function updateStatus() {
        var statusEl = document.getElementById('imageStatus');
        var submitBtn = document.getElementById('submitBtn');

        if (selectedFile) {
            statusEl.innerHTML = '✅ Image selected: <strong>' + selectedFile.name + '</strong>';
            statusEl.style.color = '#065f46';
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
        } else {
            statusEl.innerHTML = '❌ No image selected';
            statusEl.style.color = '#e76f51';
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
            submitBtn.style.cursor = 'not-allowed';
        }
    }

    
    var dropArea = document.getElementById('dropArea');

    dropArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        this.classList.add('dragover');
    });

    dropArea.addEventListener('dragleave', function(e) {
        e.preventDefault();
        this.classList.remove('dragover');
    });

    dropArea.addEventListener('drop', function(e) {
        e.preventDefault();
        this.classList.remove('dragover');
        var files = e.dataTransfer.files;
        if (files.length > 0) {
            addFile(files[0]);
        }
    });

    dropArea.addEventListener('click', function(e) {
        if (e.target === this || e.target.closest('.upload-icon') || e.target.closest('h4') || e.target.closest('p')) {
            document.getElementById('fileInput').click();
        }
    });

   
    function showToast(message) {
        var toast = document.getElementById('customToast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'customToast';
            toast.style.cssText = 'position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: #0f3b5e; color: white; padding: 14px 28px; border-radius: 12px; font-weight: 500; box-shadow: 0 8px 30px rgba(0,0,0,0.20); display: none; z-index: 999; animation: slideUp 0.3s ease; max-width: 90%; text-align: center;';
            document.body.appendChild(toast);
        }

        toast.innerHTML = message;
        toast.style.display = 'block';
        setTimeout(function() {
            toast.style.display = 'none';
        }, 4000);
    }

    
    document.getElementById('registerForm').addEventListener('submit', function(e) {
        if (!selectedFile) {
            e.preventDefault();
            document.getElementById('imageStatus').innerHTML = '❌ Please upload an image of your washroom';
            document.getElementById('imageStatus').style.color = '#e76f51';
            showToast('⚠️ Please upload an image of your washroom');
            document.querySelector('.image-upload-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }

        var lat = document.getElementById('latitude').value;
        var lng = document.getElementById('longitude').value;
        if (lat == 0 || lng == 0) {
            e.preventDefault();
            showToast('⚠️ Please select a location on the map');
            return false;
        }

        return true;
    });

    
    document.addEventListener('DOMContentLoaded', function() {
        var submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
        document.getElementById('imageStatus').innerHTML = '❌ No image selected';
        document.getElementById('imageStatus').style.color = '#e76f51';
    });

    console.log('🗺️ SE1 - Register with Map Location Picker Loaded');
</script>
