@{
    ViewBag.Title = "Manage Washrooms - SE1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<SE1.Controllers.AdminController.WashroomViewModel>

<div class="admin-washrooms">
    <div class="container">
        <div class="admin-card">

            
            <div class="admin-header-simple">
                <div>
                    <h2><i class="fas fa-restroom"></i> Manage Washrooms</h2>
                    <p>View, verify, and manage all registered washrooms.</p>
                </div>
                <a href="/Admin/Dashboard" class="btn-back-admin">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>

           
            <div id="toastContainer" style="display:none;" class="toast-message"></div>

            
            @if (Model != null && Model.Any())
            {
                <div class="washroom-table-wrapper">
                    <table class="washroom-table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Owner</th>
                                <th>Address</th>
                                <th>Hygiene</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Name" class="table-image">
                                        }
                                        else
                                        {
                                            <span class="no-image">No Image</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.Name</strong>
                                        <small class="washroom-id">ID: @item.WashroomId</small>
                                    </td>
                                    <td>
                                        <span class="owner-name">@item.OwnerName</span>
                                        <small class="owner-email">@item.OwnerEmail</small>
                                    </td>
                                    <td>@item.Address</td>
                                    <td>
                                        <span class="hygiene-score">@item.HygieneScore / 5</span>
                                        <span class="security-badge @item.SecurityStatus.ToLower().Replace(" ", "-")">@item.SecurityStatus</span>
                                    </td>
                                    <td>
                                        @if (item.VerifiedStatus)
                                        {
                                            <span class="status-badge verified">✅ Verified</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge pending">⏳ Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            @if (!item.VerifiedStatus)
                                            {
                                                <button class="btn-verify" onclick="verifyWashroom(@item.WashroomId)">
                                                    <i class="fas fa-check"></i> Verify
                                                </button>
                                            }
                                            <button class="btn-delete" onclick="deleteWashroom(@item.WashroomId)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                            <button class="btn-view" onclick="viewDetails(@item.WashroomId)">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-restroom"></i>
                    <h4>No Washrooms Registered</h4>
                    <p>There are no washrooms registered in the system yet.</p>
                </div>
            }
        </div>
    </div>
</div>


<style>
    .admin-washrooms {
        padding: 40px 0 60px;
        background: #f4f7fc;
        min-height: calc(100vh - 200px);
    }

    .admin-card {
        max-width: 1200px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 24px;
        padding: 30px 35px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    }

    .admin-header-simple {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f1f5f9;
    }

        .admin-header-simple h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0a2a3f;
            margin: 0;
        }

            .admin-header-simple h2 i {
                color: #2a9d8f;
                margin-right: 8px;
            }

        .admin-header-simple p {
            color: #64748b;
            margin: 0;
        }

    .btn-back-admin {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        background: #f1f5f9;
        color: #475569;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-back-admin:hover {
            background: #e2e8f0;
            color: #0f3b5e;
        }

   
    .toast-message {
        padding: 12px 18px;
        border-radius: 12px;
        margin-bottom: 16px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .toast-message.success {
            background: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .toast-message.error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

    .washroom-table-wrapper {
        overflow-x: auto;
    }

    .washroom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

        .washroom-table thead {
            background: #f8fafc;
        }

        .washroom-table th {
            padding: 12px 16px;
            text-align: left;
            font-weight: 700;
            color: #475569;
            border-bottom: 2px solid #e2e8f0;
        }

        .washroom-table td {
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .washroom-table tr:hover {
            background: #f8fafc;
        }

    .table-image {
        width: 50px;
        height: 50px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #e2e8f0;
    }

    .no-image {
        color: #94a3b8;
        font-size: 0.8rem;
    }

    .washroom-id {
        display: block;
        color: #94a3b8;
        font-size: 0.7rem;
    }

    .owner-name {
        display: block;
        font-weight: 500;
        color: #0a2a3f;
    }

    .owner-email {
        display: block;
        color: #94a3b8;
        font-size: 0.75rem;
    }

    .hygiene-score {
        display: block;
        font-weight: 700;
        color: #0f3b5e;
    }

    .security-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
    }

        .security-badge.very-safe {
            background: #d1fae5;
            color: #065f46;
        }

        .security-badge.safe {
            background: #dbeafe;
            color: #1e40af;
        }

        .security-badge.needs-attention {
            background: #fef3c7;
            color: #92400e;
        }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
    }

        .status-badge.verified {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.pending {
            background: #fef3c7;
            color: #92400e;
        }

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-verify {
        padding: 6px 14px;
        background: #10b981;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-verify:hover {
            background: #059669;
            transform: scale(1.02);
        }

    .btn-delete {
        padding: 6px 12px;
        background: #fee2e2;
        color: #991b1b;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-delete:hover {
            background: #fecaca;
            transform: scale(1.02);
        }

    .btn-view {
        padding: 6px 12px;
        background: #e2e8f0;
        color: #475569;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-view:hover {
            background: #cbd5e1;
            transform: scale(1.02);
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 3.5rem;
            color: #cbd5e1;
            margin-bottom: 16px;
        }

        .empty-state h4 {
            font-size: 1.3rem;
            color: #0a2a3f;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: #94a3b8;
        }

</style>


<script>

    function verifyWashroom(id) {
        if (!confirm('Are you sure you want to verify this washroom?')) return;

        fetch('/Admin/VerifyWashroom', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'id=' + id
        })
            .then(response => response.json())
            .then(data => {
                showToast(data.success ? 'success' : 'error', data.message);
                if (data.success) {
                    setTimeout(() => location.reload(), 1500);
                }
            })
            .catch(error => {
                showToast('error', 'An error occurred: ' + error);
            });
    }

    
    function deleteWashroom(id) {
        if (!confirm('Are you sure you want to delete this washroom? This action cannot be undone!')) return;

        fetch('/Admin/DeleteWashroom', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'id=' + id
        })
            .then(response => response.json())
            .then(data => {
                showToast(data.success ? 'success' : 'error', data.message);
                if (data.success) {
                    setTimeout(() => location.reload(), 1500);
                }
            })
            .catch(error => {
                showToast('error', 'An error occurred: ' + error);
            });
    }

    
    function viewDetails(id) {
        alert('Washroom ID: ' + id + '\nDetails page coming soon!');
    }

   
    function showToast(type, message) {
        const container = document.getElementById('toastContainer');
        container.style.display = 'block';
        container.className = 'toast-message ' + type;
        container.innerHTML = (type === 'success' ? '✅ ' : '❌ ') + message;

        setTimeout(() => {
            container.style.display = 'none';
        }, 4000);
    }
</script>