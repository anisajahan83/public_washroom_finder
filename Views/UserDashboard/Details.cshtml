<script>
   
    var selectedRating = @(Model.UserRating > 0 ? Model.UserRating : 0);

    function setRating(rating) {
        selectedRating = rating;
        var stars = document.querySelectorAll('#starRating i');
        stars.forEach(function (star, index) {
            if (index < rating) {
                star.classList.add('active');
            } else {
                star.classList.remove('active');
            }
        });
        document.getElementById('ratingLabel').textContent = 'Rating: ' + rating + ' star' + (rating > 1 ? 's' : '');
    }

    @if (Model.UserRating > 0)
        {
            <text>setRating(@Model.UserRating);</text>
    }

        
        function submitReview(washroomId) {
            var rating = selectedRating;
            var comment = document.getElementById('reviewComment').value.trim();

            if (rating === 0) {
                showToast('Please select a rating first.');
                return;
            }

            var statusDiv = document.getElementById('reviewStatus');
            statusDiv.style.display = 'none';

            fetch('/UserDashboard/RateWashroom', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'washroomId=' + washroomId + '&rating=' + rating + '&comment=' + encodeURIComponent(comment)
            })
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    statusDiv.style.display = 'block';
                    statusDiv.className = 'alert alert-success';
                    statusDiv.innerHTML = '<i class="fas fa-check-circle"></i> ' + data.message;

                    if (data.success) {
                        showToast(data.message);
                    }
                })
                .catch(function (error) {
                    statusDiv.style.display = 'block';
                    statusDiv.className = 'alert alert-danger';
                    statusDiv.innerHTML = '<i class="fas fa-exclamation-circle"></i> An error occurred.';
                });
        }

   
    function toggleFavorite(washroomId, element) {
        fetch('/UserDashboard/ToggleFavorite', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'washroomId=' + washroomId
        })
            .then(function (response) {
                return response.json();
            })
            .then(function (data) {
                if (data.success) {
                    element.classList.toggle('active');
                    var span = element.querySelector('span');
                    if (span) {
                        span.textContent = element.classList.contains('active') ? 'Favorited' : 'Add to Favorites';
                    }
                    showToast(data.message);
                } else {
                    showToast(data.message);
                }
            })
            .catch(function (error) {
                showToast('An error occurred.');
            });
    }

    
    function navigateTo(lat, lng) {
        var url = 'https://www.google.com/maps/dir/?api=1&destination=' + lat + ',' + lng;
        window.open(url, '_blank');
    }

   
    function changeImage(url) {
        document.getElementById('mainImage').src = url;
    }

    
    function showToast(message) {
        var toast = document.getElementById('customToast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'customToast';
            toast.style.cssText = 'position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%); background: #0f3b5e; color: white; padding: 14px 28px; border-radius: 12px; font-weight: 500; box-shadow: 0 8px 30px rgba(0,0,0,0.20); display: none; z-index: 999; animation: slideUp 0.3s ease; max-width: 90%; text-align: center;';
            document.body.appendChild(toast);
        }

        toast.innerHTML = message;
        toast.style.display = 'block';

        setTimeout(function () {
            toast.style.display = 'none';
        }, 3000);
    }

    console.log('🚻 SE1 - Washroom Details Loaded');
</script>