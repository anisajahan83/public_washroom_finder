@{
    ViewBag.Title = "Washroom Details - SE1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model SE1.Controllers.UserDashboardController.WashroomDetailViewModel

<div class="details-page">
    <div class="container">
        <div class="details-card">

            <div class="back-header">
                <a href="javascript:history.back()" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
                <button class="btn-favorite @(Model.IsFavorite ? "active" : "")" onclick="toggleFavorite(@Model.WashroomId, this)">
                    <i class="fas fa-heart"></i> <span>@(Model.IsFavorite ? "Favorited" : "Add to Favorites")</span>
                </button>
            </div>

           
            <div class="image-gallery">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="main-image" id="mainImage">
                }
                else
                {
                    <div class="no-image-large">
                        <i class="fas fa-toilet"></i>
                        <span>No Image Available</span>
                    </div>
                }

                @if (Model.AllImages != null && Model.AllImages.Count > 1)
                {
                    <div class="thumbnail-gallery">
                        @foreach (var img in Model.AllImages)
                        {
                            <img src="@img" alt="Thumbnail" class="thumbnail" onclick="changeImage('@img')">
                        }
                    </div>
                }
            </div>

           
            <div class="details-header">
                <div>
                    <h1>@Model.Name</h1>
                    <p class="address"><i class="fas fa-map-marker-alt"></i> @Model.Address, @Model.City</p>
                </div>
                <div class="rating-badge">
                    <div class="big-rating">
                        <i class="fas fa-star"></i>
                        <span>@Model.AvgRating.ToString("F1")</span>
                    </div>
                    <span class="total-ratings">(@Model.TotalRatings reviews)</span>
                </div>
            </div>

            
            <div class="status-tags">
                <span class="tag @(Model.IsOpen ? "open" : "closed")">
                    <i class="fas @(Model.IsOpen ? "fa-check-circle" : "fa-times-circle")"></i>
                    @(Model.IsOpen ? "Open Now" : "Closed")
                </span>
                <span class="tag verified">
                    <i class="fas fa-check-circle"></i> @(Model.VerifiedStatus ? "Verified" : "Pending")
                </span>
                <span class="tag security @Model.SecurityStatus.ToLower().Replace(" ", "-")">
                    <i class="fas fa-shield-alt"></i> @Model.SecurityStatus
                </span>
                <span class="tag crowd">
                    <i class="fas fa-users"></i> @Model.CrowdLevel
                </span>
                <span class="tag cost @(Model.UsageCost == 0 ? "free" : "paid")">
                    <i class="fas fa-money-bill"></i> @(Model.UsageCost == 0 ? "Free" : "BDT " + Model.UsageCost)
                </span>
            </div>

           
            <div class="info-grid">
                <div class="info-item">
                    <i class="fas fa-clock"></i>
                    <div>
                        <h4>Opening Hours</h4>
                        <p>@Model.OpeningHours</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-star"></i>
                    <div>
                        <h4>Hygiene Score</h4>
                        <p>@Model.HygieneScore / 5</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-phone"></i>
                    <div>
                        <h4>Contact</h4>
                        <p>@Model.ContactNumber</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-user"></i>
                    <div>
                        <h4>Owner</h4>
                        <p>@Model.OwnerName</p>
                    </div>
                </div>
            </div>

            
            <div class="facilities-section">
                <h3><i class="fas fa-concierge-bell"></i> Facilities</h3>
                <div class="facilities-grid">
                    <div class="facility-item @(Model.BathAvailability ? "available" : "unavailable")">
                        <i class="fas fa-shower"></i>
                        <span>Bath/Shower</span>
                        <span class="status-icon">@(Model.BathAvailability ? "✅" : "❌")</span>
                    </div>
                    <div class="facility-item @(Model.BabyFacility ? "available" : "unavailable")">
                        <i class="fas fa-baby"></i>
                        <span>Baby Facilities</span>
                        <span class="status-icon">@(Model.BabyFacility ? "✅" : "❌")</span>
                    </div>
                    <div class="facility-item @(Model.WheelchairAccess ? "available" : "unavailable")">
                        <i class="fas fa-wheelchair"></i>
                        <span>Wheelchair Access</span>
                        <span class="status-icon">@(Model.WheelchairAccess ? "✅" : "❌")</span>
                    </div>
                    <div class="facility-item @(Model.Handwash ? "available" : "unavailable")">
                        <i class="fas fa-hand-wash"></i>
                        <span>Handwashing</span>
                        <span class="status-icon">@(Model.Handwash ? "✅" : "❌")</span>
                    </div>
                    <div class="facility-item @(Model.HandDryer ? "available" : "unavailable")">
                        <i class="fas fa-wind"></i>
                        <span>Hand Dryer</span>
                        <span class="status-icon">@(Model.HandDryer ? "✅" : "❌")</span>
                    </div>
                </div>
            </div>

            
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="description-section">
                    <h3><i class="fas fa-align-left"></i> Description</h3>
                    <p>@Model.Description</p>
                </div>
            }

            <div class="map-section">
                <h3><i class="fas fa-map"></i> Location</h3>
                <div class="map-container">
                    <iframe style="width:100%; height:300px; border-radius:12px; border:1px solid #e2e8f0;"
                            frameborder="0"
                            scrolling="no"
                            marginheight="0"
                            marginwidth="0"
                            src="https://www.openstreetmap.org/export/embed.html?bbox=@(Model.Longitude - 0.01),@(Model.Latitude - 0.01),@(Model.Longitude + 0.01),@(Model.Latitude + 0.01)&amp;layer=mapnik&amp;marker=@Model.Latitude,@Model.Longitude">
                    </iframe>
                </div>
                <button class="btn-navigate" onclick="navigateTo(@Model.Latitude.ToString().Replace(",", "."), @Model.Longitude.ToString().Replace(",", "."))">
                    <i class="fas fa-directions"></i> Get Directions
                </button>
            </div>

            <div class="rate-section">
                <h3><i class="fas fa-star"></i> Rate & Review</h3>
                <div class="rating-input">
                    <div class="stars" id="starRating">
                        <i class="fas fa-star" data-rating="1" onclick="setRating(1)"></i>
                        <i class="fas fa-star" data-rating="2" onclick="setRating(2)"></i>
                        <i class="fas fa-star" data-rating="3" onclick="setRating(3)"></i>
                        <i class="fas fa-star" data-rating="4" onclick="setRating(4)"></i>
                        <i class="fas fa-star" data-rating="5" onclick="setRating(5)"></i>
                    </div>
                    <span id="ratingLabel">Select rating</span>
                </div>
                <div class="review-input">
                    <textarea id="reviewComment" class="form-control" placeholder="Share your experience..." rows="3">@Model.UserComment</textarea>
                    <button class="btn-submit-review" onclick="submitReview(@Model.WashroomId)">
                        <i class="fas fa-paper-plane"></i> Submit Review
                    </button>
                </div>
                <div id="reviewStatus" style="display:none;" class="alert alert-success"></div>
            </div>

            
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="reviews-section">
                    <h3><i class="fas fa-comments"></i> User Reviews</h3>
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <strong>@review.UserName</strong>
                                <div class="review-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= review.Rating ? "filled" : "")"></i>
                                    }
                                </div>
                            </div>
                            <p class="review-comment">"@review.Comment"</p>
                            <span class="review-date"><i class="fas fa-calendar"></i> @review.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>


