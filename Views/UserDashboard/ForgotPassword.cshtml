@{
    ViewBag.Title = "Forgot Password - SE1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="forgot-password-page">
    <div class="container">
        <div class="forgot-card">

            
            <div class="forgot-header">
                <div class="forgot-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h2>Forgot Password</h2>
                <p>Enter your email address and set a new password.</p>
            </div>

          
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            
            <form method="post" action="/UserDashboard/ForgotPassword" class="forgot-form">

                <div class="form-group">
                    <label><i class="fas fa-envelope"></i> Email Address <span class="required">*</span></label>
                    <input type="email" name="email" class="form-control" placeholder="Enter your registered email" required>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-lock"></i> New Password <span class="required">*</span></label>
                    <div class="password-wrapper">
                        <input type="password" name="newPassword" class="form-control" placeholder="Enter new password (min 6 characters)" required minlength="6">
                        <span class="password-toggle" onclick="togglePassword(this)">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-lock"></i> Confirm New Password <span class="required">*</span></label>
                    <div class="password-wrapper">
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm your new password" required>
                        <span class="password-toggle" onclick="togglePassword(this)">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-reset">
                        <i class="fas fa-sync-alt"></i> Reset Password
                    </button>
                    <a href="/Home/Login" class="btn-back-login">
                        <i class="fas fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>


<style>
    .forgot-password-page {
        padding: 60px 0;
        background: #f4f7fc;
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
    }

    .forgot-card {
        max-width: 450px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 24px;
        padding: 40px 35px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    }

    .forgot-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .forgot-icon {
        font-size: 3rem;
        color: #2a9d8f;
        background: rgba(42, 157, 143, 0.10);
        padding: 16px;
        border-radius: 50%;
        width: 80px;
        height: 80px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .forgot-header h2 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0a2a3f;
        margin-bottom: 4px;
    }

    .forgot-header p {
        color: #64748b;
        font-size: 0.95rem;
        margin: 0;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }

    .alert-danger {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .alert-success {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .forgot-form .form-group {
        margin-bottom: 18px;
    }

        .forgot-form .form-group label {
            display: block;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 4px;
            font-size: 0.95rem;
        }

            .forgot-form .form-group label i {
                color: #2a9d8f;
                margin-right: 6px;
            }

    .required {
        color: #e76f51;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        transition: all 0.2s;
        background: #f8fafc;
        color: #1e293b;
    }

        .form-control:focus {
            outline: none;
            border-color: #2a9d8f;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(42, 157, 143, 0.10);
        }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 45px;
        }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #94a3b8;
        transition: color 0.2s;
    }

        .password-toggle:hover {
            color: #2a9d8f;
        }

    .form-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 8px;
    }

    .btn-reset {
        width: 100%;
        padding: 14px;
        background: #0f3b5e;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-reset:hover {
            background: #1a4f77;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(15, 59, 94, 0.20);
        }

    .btn-back-login {
        width: 100%;
        padding: 14px;
        background: #e2e8f0;
        color: #475569;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-back-login:hover {
            background: #cbd5e1;
            transform: translateY(-2px);
        }

    @@media (max-width: 480px) {
        .forgot-card {
            padding: 25px 20px;
            margin: 0 16px;
        }
    }
</style>

<script>
    function togglePassword(element) {
        var input = element.parentElement.querySelector('.form-control');
        var icon = element.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }
</script>