@{
    ViewBag.Title = "Change Password - SE1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="change-password-page">
    <div class="container">
        <div class="change-card">

            
            <div class="change-header">
                <h2><i class="fas fa-key"></i> Change Password</h2>
                <a href="/UserDashboard/Dashboard" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>

            
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            
            <form method="post" action="/UserDashboard/ChangePassword" class="change-form">

                <div class="form-group">
                    <label><i class="fas fa-lock"></i> Current Password <span class="required">*</span></label>
                    <div class="password-wrapper">
                        <input type="password" name="currentPassword" class="form-control" placeholder="Enter your current password" required>
                        <span class="password-toggle" onclick="togglePassword(this)">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-lock"></i> New Password <span class="required">*</span></label>
                    <div class="password-wrapper">
                        <input type="password" name="newPassword" class="form-control" placeholder="Enter new password (min 6 characters)" required minlength="6">
                        <span class="password-toggle" onclick="togglePassword(this)">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-lock"></i> Confirm New Password <span class="required">*</span></label>
                    <div class="password-wrapper">
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm your new password" required>
                        <span class="password-toggle" onclick="togglePassword(this)">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-update">
                        <i class="fas fa-save"></i> Update Password
                    </button>
                    <a href="/UserDashboard/Dashboard" class="btn-cancel">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>


<style>
    .change-password-page {
        padding: 40px 0 60px;
        background: #f4f7fc;
        min-height: calc(100vh - 200px);
    }

    .change-card {
        max-width: 500px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 24px;
        padding: 35px 40px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    }

    .change-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f1f5f9;
    }

        .change-header h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0a2a3f;
            margin: 0;
        }

            .change-header h2 i {
                color: #2a9d8f;
                margin-right: 8px;
            }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background: #f1f5f9;
        color: #475569;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: #e2e8f0;
            color: #0f3b5e;
        }

    .alert {
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }

    .alert-danger {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .alert-success {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .change-form .form-group {
        margin-bottom: 18px;
    }

        .change-form .form-group label {
            display: block;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 4px;
            font-size: 0.95rem;
        }

            .change-form .form-group label i {
                color: #2a9d8f;
                margin-right: 6px;
            }

    .required {
        color: #e76f51;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        transition: all 0.2s;
        background: #f8fafc;
        color: #1e293b;
    }

        .form-control:focus {
            outline: none;
            border-color: #2a9d8f;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(42, 157, 143, 0.10);
        }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 45px;
        }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #94a3b8;
        transition: color 0.2s;
    }

        .password-toggle:hover {
            color: #2a9d8f;
        }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 8px;
    }

    .btn-update {
        padding: 12px 32px;
        background: #0f3b5e;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        justify-content: center;
    }

        .btn-update:hover {
            background: #1a4f77;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(15, 59, 94, 0.20);
        }

    .btn-cancel {
        padding: 12px 32px;
        background: #e2e8f0;
        color: #475569;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-cancel:hover {
            background: #cbd5e1;
            transform: translateY(-2px);
        }

    @@media (max-width: 480px) {
        .change-card {
            padding: 20px;
            margin: 0 16px;
        }

        .change-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>

<script>
    function togglePassword(element) {
        var input = element.parentElement.querySelector('.form-control');
        var icon = element.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }
</script>